# Where aiwatch stores calls (default: .aiwatch/aiwatch.db in the current directory)
AIWATCH_DB=.aiwatch/aiwatch.db
# Your own price table (default: the bundled table, which has no real prices)
AIWATCH_PRICES=./prices.yaml
# Show aiwatch's internal debug logs
AIWATCH_DEBUG=
# Provider keys are read by the provider SDKs, not by aiwatch
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
